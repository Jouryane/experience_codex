        { "action": "move_file", "args": { "source": "made/copied.txt", "target": "made/moved.txt" } },
        { "action": "read_file", "args": { "path": "out/new.txt" } }
      ],
      "postconditions": [
        { "key": "file:out/new.txt.exists", "expected": true },
